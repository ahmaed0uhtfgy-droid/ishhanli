rules_version = '2';
// قفل كامل: ولا متصفح يقدر يقرا أو يكتب في Firestore مباشرة.
// السيرفر (Cloudflare) بيدخل بحساب الخدمة (Service Account) اللي بيتخطى القواعد دي، وده المقصود.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
